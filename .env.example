POSTGRES_DB=household_budget
POSTGRES_USER=budget
POSTGRES_PASSWORD=budget
DATABASE_URL=postgresql://budget:budget@127.0.0.1:5433/household_budget
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_MIGRATIONS_RUN=true
JWT_SECRET=replace-with-a-long-secret
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
RESEND_API_KEY=re_xxxxxxxxx
MAIL_FROM=Mercury Lab <noreply@your-domain.com>
API_KEY_ENCRYPTION_SECRET=replace-with-at-least-32-random-characters

# Mercury Lab OIDC (production values; override redirect URLs for local development)
OIDC_ISSUER=https://accounts.mercury-lab.uk/realms/mercury
OIDC_CLIENT_ID=household-budget-web
OIDC_REDIRECT_URI=https://household-budget.mercury-lab.uk/api/auth/callback/keycloak
OIDC_POST_LOGOUT_REDIRECT_URI=https://household-budget.mercury-lab.uk/
MERCURY_IDENTITY_API_URL=
# Mercury Identity에서 합의된 서버 전용 연결 API 경로
MERCURY_IDENTITY_ACCOUNT_LINK_PATH=
# Keycloak confidential service client. 브라우저나 NEXT_PUBLIC_* 환경변수에 노출하지 않습니다.
MERCURY_IDENTITY_CLIENT_ID=household-budget-api
MERCURY_IDENTITY_CLIENT_SECRET=
SESSION_SECRET=replace-with-at-least-32-random-characters
